# Waifair Backend API - Environment Configuration
PORT=5000
NODE_ENV=production

# Permitted CORS Origins (comma-separated list of deployed Frontend and Admin URLs)
CORS_ORIGIN=https://your-frontend.vercel.app,https://your-admin.vercel.app

# Firebase Admin SDK Credentials
# Download serviceAccountKey.json from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_firebase_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
